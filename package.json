{
  "name": "ghl-onboarding-tool",
  "version": "1.0.0",
  "description": "GHL Client Onboarding Automation - builds full funnel from Master Snapshot",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "onboard": "node onboard.js",
    "build:worker": "esbuild src/worker.js --bundle --outfile=dist/worker.mjs --format=esm --minify",
    "deploy": "npm run build:worker && wrangler deploy"
  },
  "dependencies": {
    "express": "^4.18.2",
    "axios": "^1.6.0",
    "dotenv": "^16.3.1",
    "googleapis": "^140.0.0"
  }
}
